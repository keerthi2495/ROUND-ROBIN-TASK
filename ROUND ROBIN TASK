from collections import deque
def Find(tasks, time_slice):
    Q = deque()
    for i in range(len(tasks)):
        Q.append((tasks[i], i + 1))  # task_time, task_number
    time = 0
    while Q:
        task, task_num = Q.popleft()  # dequeue task
        executed = min(task, time_slice)
        time += executed
        print("task {} -> executed {} units : time {}".format(task_num, executed, time))
        if task > time_slice:
            Q.append((task - executed, task_num))  # add back the task with remaining time
tasks = [10, 5, 8]
time_slice = 4
Find(tasks, time_slice)
